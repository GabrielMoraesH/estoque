PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nome_do_banco
DB_USER=usuario
DB_PASSWORD=sua_senha

JWT_SECRET=troque_por_um_segredo
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
REQUEST_BODY_LIMIT=100kb

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Em producao, informe as origens permitidas, separadas por virgula.
# Sem esta variavel, requisicoes cross-origin sao negadas em producao.
CORS_ORIGIN=http://localhost:3000

# Credenciais de desenvolvimento. Em producao, defina valores unicos e diferentes destes.
SEED_ADMIN_PASSWORD=admin123
SEED_GESTOR_PASSWORD=gestor123
SEED_ESTOQUISTA_PASSWORD=estoque123
