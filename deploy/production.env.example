# Copy this file outside version control and replace every placeholder.
POSTGRES_DB=estoque_med
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_strong_database_password
JWT_SECRET=replace_with_long_random_secret

# Host port published by the HTTP-only Caddy edge. TLS is configured at go-live.
EDGE_HTTP_PORT=80

# Set this on the server to the exact public HTTPS origin before go-live.
# An empty value rejects browser requests that include Origin in production.
CORS_ORIGIN=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
