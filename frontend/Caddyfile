:80 {
	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	handle /health {
		respond "OK" 200
	}

	handle_path /api/* {
		reverse_proxy backend:5000
	}

	handle {
		root * /srv

		route {
			try_files {path} /index.html

			@hashedAssets path_regexp hashedAsset \.([0-9a-f]{8,})\.(css|js|map|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$
			header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

			@index path / /index.html
			header @index Cache-Control "no-cache"

			file_server
		}
	}
}
